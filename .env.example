# Copy to .env and adjust. Never commit .env.

# PostgreSQL password used by docker compose (db, api, worker).
POSTGRES_PASSWORD=change-me

# "password": people sign in with an e-mail and a password; the first visit creates the owner.
#             This is the default of docker-compose.yml.
# "local":    no sign-in, one implicit owner. Only for a machine you control (ports bound to 127.0.0.1).
#             This is the default when the API runs without Docker.
# "token":    every request needs "Authorization: Bearer <token>" (select-api create-token). For scripts.
SELECT_AUTH_MODE=password

# The address people type to open Select. Invitation links use it; with https:// the session cookie is Secure.
SELECT_PUBLIC_URL=http://localhost:3000

# Fernet key encrypting provider API keys and mailbox passwords at rest (32 url-safe base64 bytes).
# Generate one with:  docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated on first use and stored in the data volume (/data/secret.key).
# Keep a copy: without it, stored keys and mailbox passwords cannot be decrypted.
SELECT_SECRET_KEY=

# How long a sign-in lasts, in days (1-365).
SELECT_SESSION_DAYS=30

# Used when running without Docker (scripts/dev-up.sh, `select-api serve`).
SELECT_DATABASE_URL=postgresql+psycopg://select:change-me@127.0.0.1:5432/select
SELECT_DATA_DIR=./data
# Pause between events of the demo week, in milliseconds (the UI shows progress).
SELECT_DEMO_STEP_DELAY_MS=350
