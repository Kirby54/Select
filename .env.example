# Copy to .env and adjust. Never commit .env.

# PostgreSQL password used by docker compose (db, api, worker).
POSTGRES_PASSWORD=change-me

# "local": no login, one implicit owner. Only for a machine you control; compose binds ports to 127.0.0.1.
# "token": every request needs "Authorization: Bearer <token>"; create tokens with `select-api create-token`.
SELECT_AUTH_MODE=local

# Fernet key used to encrypt provider API keys at rest (32 url-safe base64 bytes).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated on first use and stored in the data volume (data/secret.key).
SELECT_SECRET_KEY=

# Used when running without Docker (scripts/dev-up.sh, `select-api serve`).
SELECT_DATABASE_URL=postgresql+psycopg://select:change-me@127.0.0.1:5432/select
SELECT_DATA_DIR=./data
# Pause between events of the demo week, in milliseconds (the UI shows progress).
SELECT_DEMO_STEP_DELAY_MS=350
