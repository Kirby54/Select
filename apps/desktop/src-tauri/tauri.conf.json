{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Select",
  "version": "1.0.0",
  "identifier": "app.select.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Select",
        "width": 1320,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Run your company with AI agents that earn their autonomy",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}